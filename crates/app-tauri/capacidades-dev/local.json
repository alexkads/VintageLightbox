{
  "identifier": "pilha-local",
  "description": "A pilha local (make up do e-commerce). Fica fora de capabilities/ de propósito: o main.rs só a adiciona em build de desenvolvimento (§6, regra 1).",
  "windows": [
    "principal",
    "tela-do-cliente"
  ],
  "remote": {
    "urls": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "allow-escolher-raw",
    "allow-ler-raw",
    "allow-converter-raw",
    "allow-ler-da-origem",
    "allow-listar-origem",
    "allow-escolher-origem",
    "allow-cartoes-montados",
    "allow-pasta-de-saida",
    "allow-escolher-pasta",
    "allow-esquecer-pasta",
    "allow-nomes-na-pasta",
    "allow-gravar-na-pasta",
    "allow-abrir-tela-do-cliente",
    "allow-fechar-tela-do-cliente",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}
