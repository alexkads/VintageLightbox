{
  "identifier": "tela-do-vite",
  "description": "A tela servida pelo Vite desta máquina (VLB_TELA_URL). Só existe em build de depuração.",
  "windows": [
    "principal",
    "tela-do-cliente"
  ],
  "remote": {
    "urls": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-escolher-raw",
    "allow-ler-raw",
    "allow-converter-raw",
    "allow-cartoes-montados",
    "allow-escolher-origem",
    "allow-listar-origem",
    "allow-ler-da-origem",
    "allow-pasta-de-saida",
    "allow-escolher-pasta",
    "allow-esquecer-pasta",
    "allow-nomes-na-pasta",
    "allow-gravar-na-pasta",
    "allow-abrir-tela-do-cliente",
    "allow-fechar-tela-do-cliente",
    "allow-ha-sessao",
    "allow-entrar",
    "allow-sair",
    "allow-chamar-api",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "allow-registrar-no-terminal"
  ]
}
