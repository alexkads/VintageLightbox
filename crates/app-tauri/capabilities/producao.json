{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "producao",
  "description": "A ponte, só para o site de produção (DESKTOP_TAURI §6, regra 1).",
  "windows": [
    "principal"
  ],
  "remote": {
    "urls": [
      "https://recordarfotos.com.br/*"
    ]
  },
  "permissions": [
    "allow-escolher-raw",
    "allow-ler-raw",
    "allow-converter-raw",
    "allow-ler-da-origem",
    "allow-listar-origem",
    "allow-escolher-origem",
    "allow-cartoes-montados",
    "allow-pasta-de-saida",
    "allow-escolher-pasta",
    "allow-esquecer-pasta",
    "allow-nomes-na-pasta",
    "allow-gravar-na-pasta",
    "allow-abrir-tela-do-cliente",
    "allow-fechar-tela-do-cliente",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}
