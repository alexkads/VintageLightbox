  "windows": [
    "principal"
  ],
  "permissions": [
    "core:default",
    "allow-escolher-raw",
    "allow-ler-raw",
    "allow-converter-raw",
    "allow-cartoes-montados",
    "allow-escolher-origem",
    "allow-listar-origem",
