// VintageLightbox - Collections Panel
// Collections list in left sidebar

import { Theme } from "../design_system/tokens.slint";
import { PanelHeader, MenuItem } from "../design_system/primitives.slint";

export component CollectionsPanel inherits VerticalLayout {
    in property <[string]> collections: [];
    in property <string> selected-collection: "";
    callback collection-selected(string);
    callback create-collection();

    spacing: Theme.space-xs;

    PanelHeader {
        title: "Collections";
    }

    Rectangle {
        height: 26px;
        background: Theme.bg-elevated;
        border-radius: Theme.radius-sm;

        HorizontalLayout {
            padding-left: Theme.space-lg;

            Text {
                text: "+ Create Collection";
                color: Theme.text-muted;
                font-size: Theme.font-sm;
                vertical-alignment: center;
            }
        }

        TouchArea {
            clicked => { root.create-collection(); }
        }
    }

    for collection in root.collections: MenuItem {
        text: collection;
        selected: collection == root.selected-collection;
        clicked => { root.collection-selected(collection); }
    }
}
