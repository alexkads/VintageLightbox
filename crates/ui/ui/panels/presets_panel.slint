// VintageLightbox - Presets Panel
// Develop presets in left sidebar

import { Theme } from "../design_system/tokens.slint";
import { PanelHeader, MenuItem } from "../design_system/primitives.slint";

export component PresetsPanel inherits VerticalLayout {
    in property <string> selected-preset: "";
    callback preset-selected(string);

    spacing: Theme.space-xs;

    PanelHeader {
        title: "Presets";
    }

    MenuItem {
        text: "Default";
        selected: root.selected-preset == "default";
        clicked => { root.preset-selected("default"); }
    }

    MenuItem {
        text: "Auto";
        selected: root.selected-preset == "auto";
        clicked => { root.preset-selected("auto"); }
    }

    MenuItem {
        text: "B&W";
        selected: root.selected-preset == "bw";
        clicked => { root.preset-selected("bw"); }
    }
}
