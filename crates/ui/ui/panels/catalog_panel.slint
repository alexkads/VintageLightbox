// VintageLightbox - Catalog Panel
// Catalog navigation in left sidebar

import { Theme } from "../design_system/tokens.slint";
import { PanelHeader, MenuItem, Spacer } from "../design_system/primitives.slint";

export component CatalogPanel inherits VerticalLayout {
    in property <string> selected-item: "all";
    callback item-selected(string);

    spacing: Theme.space-xs;

    PanelHeader {
        title: "Catalog";
    }

    MenuItem {
        text: "All Photographs";
        selected: root.selected-item == "all";
        clicked => { root.item-selected("all"); }
    }

    MenuItem {
        text: "Quick Collection";
        selected: root.selected-item == "quick";
        clicked => { root.item-selected("quick"); }
    }
}
