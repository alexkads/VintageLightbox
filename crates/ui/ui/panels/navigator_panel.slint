// VintageLightbox - Navigator Panel
// Preview panel in left sidebar

import { Theme } from "../design_system/tokens.slint";
import { PanelHeader, Card } from "../design_system/primitives.slint";

export component NavigatorPanel inherits VerticalLayout {
    in property <image> preview-image;

    spacing: Theme.space-xs;

    PanelHeader {
        title: "Navigator";
    }

    Card {
        height: 140px;

        if root.preview-image.width > 0: Image {
            source: root.preview-image;
            width: 100%;
            height: 100%;
            image-fit: contain;
        }

        if root.preview-image.width == 0: Text {
            text: "Preview";
            color: Theme.text-disabled;
            font-size: Theme.font-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
