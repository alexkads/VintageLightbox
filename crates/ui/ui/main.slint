// VintageLightbox - Main Application Window
// Root component that composes views and manages application state

import { Theme } from "design_system/tokens.slint";
import { Overlay } from "design_system/primitives.slint";
import { TileData, RowData } from "types.slint";
import { Toolbar } from "components/toolbar.slint";
import { LibraryView } from "views/library_view.slint";
import { DevelopView } from "views/develop_view.slint";

export { TileData, RowData }

export component MainWindow inherits Window {
    title: "VintageLightbox";
    width: 1400px;
    height: 900px;
    background: Theme.bg-app;

    // ============================================
    // CALLBACKS - Bridge to Rust backend
    // ============================================
    callback import_clicked();
    callback tile_clicked(string);
    callback back_clicked();
    callback rate_photo(string, int);
    callback set_color_label(string, string);
    callback navigate(int);
    callback apply_edits(float, float);
    callback save_edits(string, float, float);
    callback export_clicked(string);

    // ============================================
    // STATE - Application data
    // ============================================
    in-out property <[RowData]> grid_model: [];
    in-out property <image> detail_image;
    in-out property <string> detail_id;
    in-out property <string> detail_name;
    in-out property <string> detail_date;
    in-out property <string> detail_camera;
    in-out property <string> detail_exposure;
    in-out property <string> detail_rating;
    in-out property <int> current_view: 0;
    in-out property <bool> is_busy: false;
    in-out property <string> busy_message: "Processing...";
    in-out property <float> active_exposure: 0.0;
    in-out property <float> active_contrast: 1.0;

    // ============================================
    // KEYBOARD HANDLING
    // ============================================
    forward-focus: focus_scope;

    focus_scope := FocusScope {
        key-pressed(event) => {
            if (root.current_view == 1) {
                // Navigation keys
                if (event.text == Key.RightArrow) {
                    root.navigate(1);
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.navigate(-1);
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.back_clicked();
                    return accept;
                }
                
                // Rating shortcuts (0-5)
                if (event.text == "0") {
                    root.rate_photo(root.detail_id, 0);
                    return accept;
                }
                if (event.text == "1") {
                    root.rate_photo(root.detail_id, 1);
                    return accept;
                }
                if (event.text == "2") {
                    root.rate_photo(root.detail_id, 2);
                    return accept;
                }
                if (event.text == "3") {
                    root.rate_photo(root.detail_id, 3);
                    return accept;
                }
                if (event.text == "4") {
                    root.rate_photo(root.detail_id, 4);
                    return accept;
                }
                if (event.text == "5") {
                    root.rate_photo(root.detail_id, 5);
                    return accept;
                }
                
                // Color label shortcuts (6-9)
                if (event.text == "6") {
                    root.set_color_label(root.detail_id, "red");
                    return accept;
                }
                if (event.text == "7") {
                    root.set_color_label(root.detail_id, "yellow");
                    return accept;
                }
                if (event.text == "8") {
                    root.set_color_label(root.detail_id, "green");
                    return accept;
                }
                if (event.text == "9") {
                    root.set_color_label(root.detail_id, "blue");
                    return accept;
                }
            }
            reject
        }

        // ============================================
        // MAIN LAYOUT
        // ============================================
        VerticalLayout {
            spacing: 0px;

            // Top Toolbar
            Toolbar {
                current-view: root.current_view;
                photo-count: root.grid_model.length > 0 ? root.grid_model.length + " Photos" : "Photos";

                import-clicked => {
                    root.import_clicked();
                }
                view-changed(view) => {
                    if (view == 0 && root.current_view == 1) {
                        root.back_clicked();
                    }
                }
            }

            // View Container
            Rectangle {
                vertical-stretch: 1;

                // Library View
                if root.current_view == 0: LibraryView {
                    grid-model: root.grid_model;

                    tile-clicked(id) => {
                        root.tile_clicked(id);
                    }
                    import-clicked => {
                        root.import_clicked();
                    }
                }

                // Develop View
                if root.current_view == 1: DevelopView {
                    detail-image: root.detail_image;
                    detail-id: root.detail_id;
                    detail-name: root.detail_name;
                    detail-date: root.detail_date;
                    detail-camera: root.detail_camera;
                    detail-exposure: root.detail_exposure;
                    active-exposure <=> root.active_exposure;
                    active-contrast <=> root.active_contrast;

                    back-clicked => {
                        root.back_clicked();
                    }
                    navigate(dir) => {
                        root.navigate(dir);
                    }
                    apply-edits(exp, con) => {
                        root.apply_edits(exp, con);
                    }
                    save-edits(id, exp, con) => {
                        root.save_edits(id, exp, con);
                    }
                    export-clicked(id) => {
                        root.export_clicked(id);
                    }
                    rate-photo(id, rating) => {
                        root.rate_photo(id, rating);
                    }
                }
            }
        }
    }

    // ============================================
    // BUSY OVERLAY
    // ============================================
    Overlay {
        show: root.is_busy;
        message: root.busy_message;
    }
}
