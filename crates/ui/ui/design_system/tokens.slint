// VintageLightbox Design System - Design Tokens
// Single source of truth for all visual design decisions

export global Theme {
    // ============================================
    // COLORS - Background
    // ============================================
    out property <color> bg-app: #1a1a1a;
    out property <color> bg-surface: #252525;
    out property <color> bg-elevated: #2d2d2d;
    out property <color> bg-hover: #353535;
    out property <color> bg-active: #3a3a3a;
    out property <color> bg-overlay: #000000cc;

    // ============================================
    // COLORS - Text
    // ============================================
    out property <color> text-primary: #e0e0e0;
    out property <color> text-secondary: #b0b0b0;
    out property <color> text-muted: #808080;
    out property <color> text-disabled: #606060;
    out property <color> text-hint: #505050;

    // ============================================
    // COLORS - Accent & Interactive
    // ============================================
    out property <color> accent-primary: #4a9eff;
    out property <color> accent-hover: #5aafff;
    out property <color> accent-pressed: #3a8ee6;
    out property <color> accent-warning: #ffd700;
    out property <color> accent-success: #4ade80;
    out property <color> accent-error: #ef4444;

    // ============================================
    // COLORS - Rating & Labels
    // ============================================
    out property <color> rating-active: #ffd700;
    out property <color> rating-inactive: #404040;

    out property <color> label-red: #ef4444;
    out property <color> label-yellow: #fbbf24;
    out property <color> label-green: #4ade80;
    out property <color> label-blue: #4a9eff;
    out property <color> label-purple: #a855f7;

    // ============================================
    // COLORS - Borders
    // ============================================
    out property <color> border-default: #333333;
    out property <color> border-focus: #4a9eff;
    out property <color> border-hover: #404040;

    // ============================================
    // SPACING
    // ============================================
    out property <length> space-xxs: 2px;
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;
    out property <length> space-xxl: 32px;

    // ============================================
    // SIZING - Fixed Dimensions
    // ============================================
    out property <length> toolbar-height: 48px;
    out property <length> sidebar-width: 220px;
    out property <length> panel-width: 280px;
    out property <length> filmstrip-height: 100px;
    out property <length> tile-width: 140px;
    out property <length> tile-height: 160px;
    out property <length> thumbnail-size: 80px;

    // ============================================
    // BORDER RADIUS
    // ============================================
    out property <length> radius-xs: 2px;
    out property <length> radius-sm: 3px;
    out property <length> radius-md: 4px;
    out property <length> radius-lg: 6px;
    out property <length> radius-xl: 8px;
    out property <length> radius-full: 9999px;

    // ============================================
    // TYPOGRAPHY - Font Sizes
    // ============================================
    out property <length> font-xs: 10px;
    out property <length> font-sm: 11px;
    out property <length> font-md: 12px;
    out property <length> font-lg: 14px;
    out property <length> font-xl: 18px;
    out property <length> font-xxl: 24px;
    out property <length> font-display: 64px;

    // ============================================
    // TYPOGRAPHY - Font Weights
    // ============================================
    out property <int> weight-normal: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <int> weight-bold: 700;

    // ============================================
    // ANIMATION
    // ============================================
    out property <duration> duration-fast: 100ms;
    out property <duration> duration-normal: 200ms;
    out property <duration> duration-slow: 300ms;

    // ============================================
    // Z-INDEX (conceptual layering)
    // ============================================
    out property <int> layer-base: 0;
    out property <int> layer-elevated: 10;
    out property <int> layer-overlay: 100;
    out property <int> layer-modal: 1000;
}
