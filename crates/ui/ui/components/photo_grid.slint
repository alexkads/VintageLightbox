// VintageLightbox - Photo Grid Component
// Grid display of photo thumbnails

import { Theme } from "../design_system/tokens.slint";
import { TileData, RowData } from "../types.slint";
import { RatingDisplay } from "rating_widget.slint";
import { ListView } from "std-widgets.slint";

// Individual Photo Tile
export component PhotoTile inherits Rectangle {
    in property <TileData> data;
    callback clicked();

    width: Theme.tile-width;
    background: touch.has-hover ? Theme.bg-hover : Theme.bg-surface;
    border-radius: Theme.radius-md;

    VerticalLayout {
        spacing: Theme.space-xs;
        padding: Theme.space-xs;

        // Thumbnail Container
        Rectangle {
            height: 110px;
            background: Theme.bg-app;
            border-radius: Theme.radius-sm;

            Image {
                source: root.data.image;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            // Rating Overlay on Hover
            if touch.has-hover: Rectangle {
                y: parent.height - 20px;
                height: 20px;
                background: #000000aa;

                HorizontalLayout {
                    padding-left: Theme.space-xs;

                    RatingDisplay {
                        rating: root.data.rating;
                    }
                }
            }
        }

        // File Name
        Text {
            text: root.data.name;
            color: Theme.text-muted;
            font-size: Theme.font-xs;
            overflow: elide;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // Selection Border
    Rectangle {
        visible: touch.has-hover;
        border-width: 2px;
        border-color: Theme.accent-primary;
        border-radius: Theme.radius-md;
    }
}

// Full Photo Grid
export component PhotoGrid inherits Rectangle {
    in property <[RowData]> model: [];
    callback tile-clicked(string);

    background: Theme.bg-app;

    ListView {
        for row in root.model: HorizontalLayout {
            padding: Theme.space-sm;
            spacing: Theme.space-sm;
            height: Theme.tile-height;

            for tile in row.tiles: PhotoTile {
                data: tile;
                clicked => { root.tile-clicked(tile.id); }
            }
        }
    }
}
