// VintageLightbox - Rating Widget Component
// Reusable star rating component

import { Theme } from "../design_system/tokens.slint";

export component RatingWidget inherits Rectangle {
    in property <int> rating: 0;
    in property <int> max-rating: 5;
    in property <bool> interactive: true;
    in property <length> star-size: 16px;
    callback rating-changed(int);

    height: root.star-size;

    HorizontalLayout {
        spacing: Theme.space-xs;

        for i in 5: Rectangle {
            width: root.star-size;
            height: root.star-size;

            Text {
                text: "\u{2605}"; // Filled star
                color: (i + 1) <= root.rating ? Theme.rating-active :
                       (root.interactive && touch.has-hover) ? Theme.rating-active : Theme.rating-inactive;
                font-size: root.star-size;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            touch := TouchArea {
                enabled: root.interactive;
                clicked => {
                    root.rating-changed(i + 1);
                }
            }
        }
    }
}

// Compact version for thumbnails
export component RatingDisplay inherits Rectangle {
    in property <int> rating: 0;
    in property <length> star-size: 11px;

    height: root.star-size;

    HorizontalLayout {
        spacing: 1px;

        for i in 5: Text {
            text: "\u{2605}";
            color: (i + 1) <= root.rating ? Theme.rating-active : Theme.rating-inactive;
            font-size: root.star-size;
        }
    }
}
