// VintageLightbox - Image Viewer Component
// Zoomable and pannable image viewer

import { Theme } from "../design_system/tokens.slint";
import { IconButton, SecondaryButton } from "../design_system/primitives.slint";

export component ImageViewer inherits Rectangle {
    in property <image> source;
    in property <bool> show-navigation: true;
    callback navigate(int);
    callback back-clicked();

    background: Theme.bg-app;
    clip: true;

    property <length> pan-x: 0px;
    property <length> pan-y: 0px;
    property <float> zoom-level: 1.0;
    property <length> start-pan-x;
    property <length> start-pan-y;

    // Main Image
    Image {
        source: root.source;
        width: parent.width * root.zoom-level;
        height: parent.height * root.zoom-level;
        x: (parent.width - self.width) / 2 + root.pan-x;
        y: (parent.height - self.height) / 2 + root.pan-y;
        image-fit: contain;
    }

    // Touch Handler for Pan and Zoom
    touch := TouchArea {
        width: 100%;
        height: 100%;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.start-pan-x = root.pan-x - self.mouse-x;
                root.start-pan-y = root.pan-y - self.mouse-y;
            }
        }

        moved => {
            if (self.pressed) {
                root.pan-x = root.start-pan-x + self.mouse-x;
                root.pan-y = root.start-pan-y + self.mouse-y;
            }
        }

        scroll-event(event) => {
            if (event.delta-y > 0) {
                root.zoom-level = min(5.0, root.zoom-level + 0.1);
            } else {
                root.zoom-level = max(0.5, root.zoom-level - 0.1);
            }
            return accept;
        }

        double-clicked => {
            root.pan-x = 0px;
            root.pan-y = 0px;
            root.zoom-level = 1.0;
        }
    }

    // Back Button
    Rectangle {
        x: Theme.space-lg;
        y: Theme.space-lg;
        width: 90px;
        height: 32px;
        background: back-touch.has-hover ? Theme.bg-active : Theme.bg-elevated;
        border-radius: Theme.radius-md;

        HorizontalLayout {
            alignment: center;
            spacing: Theme.space-sm;

            Text {
                text: "\u{2190}"; // Left arrow
                color: Theme.text-primary;
                font-size: Theme.font-lg;
                vertical-alignment: center;
            }

            Text {
                text: "Library";
                color: Theme.text-primary;
                font-size: Theme.font-md;
                vertical-alignment: center;
            }
        }

        back-touch := TouchArea {
            clicked => {
                root.pan-x = 0px;
                root.pan-y = 0px;
                root.zoom-level = 1.0;
                root.back-clicked();
            }
        }
    }

    // Navigation Arrows
    if root.show-navigation: Rectangle {
        x: Theme.space-lg;
        y: (parent.height - 40px) / 2;

        IconButton {
            icon: "\u{2039}"; // Left chevron
            icon-size: Theme.font-xxl;
            clicked => { root.navigate(-1); }
        }
    }

    if root.show-navigation: Rectangle {
        x: parent.width - 56px;
        y: (parent.height - 40px) / 2;

        IconButton {
            icon: "\u{203A}"; // Right chevron
            icon-size: Theme.font-xxl;
            clicked => { root.navigate(1); }
        }
    }

    // Zoom Info (optional)
    Rectangle {
        x: parent.width - 80px;
        y: Theme.space-lg;
        width: 60px;
        height: 24px;
        background: Theme.bg-elevated;
        border-radius: Theme.radius-sm;
        visible: root.zoom-level != 1.0;

        Text {
            text: round(root.zoom-level * 100) + "%";
            color: Theme.text-secondary;
            font-size: Theme.font-sm;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
