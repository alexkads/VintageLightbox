// VintageLightbox - Histogram Component
// Placeholder histogram display

import { Theme } from "../design_system/tokens.slint";

export component Histogram inherits Rectangle {
    in property <length> chart-height: 80px;

    height: root.chart-height;
    background: Theme.bg-app;
    border-radius: Theme.radius-md;

    Text {
        text: "Histogram";
        color: Theme.text-hint;
        font-size: Theme.font-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
