// VintageLightbox - Library View
// Main library view with grid, sidebars, and filmstrip

import { Theme } from "../design_system/tokens.slint";
import { Spacer } from "../design_system/primitives.slint";
import { TileData, RowData } from "../types.slint";
import { PhotoGrid } from "../components/photo_grid.slint";
import { Filmstrip } from "../components/filmstrip.slint";
import { Histogram } from "../components/histogram.slint";
import { NavigatorPanel } from "../panels/navigator_panel.slint";
import { CatalogPanel } from "../panels/catalog_panel.slint";
import { CollectionsPanel } from "../panels/collections_panel.slint";
import { QuickDevelopPanel } from "../panels/quick_develop_panel.slint";
import { MetadataPanel } from "../panels/metadata_panel.slint";

export component LibraryView inherits VerticalLayout {
    in property <[RowData]> grid-model: [];
    in property <image> preview-image;

    callback tile-clicked(string);
    callback import-clicked();

    spacing: 0px;

    // Main Content Area
    HorizontalLayout {
        spacing: 0px;

        // Left Sidebar
        Rectangle {
            width: Theme.sidebar-width;
            background: Theme.bg-surface;

            VerticalLayout {
                padding: Theme.space-sm;
                spacing: Theme.space-xs;

                NavigatorPanel {
                    preview-image: root.preview-image;
                }

                Spacer { size: Theme.space-lg; }

                CatalogPanel {
                    selected-item: "all";
                }

                Spacer { size: Theme.space-lg; }

                CollectionsPanel { }

                // Flexible space
                Rectangle { vertical-stretch: 1; }
            }
        }

        // Center Content - Photo Grid or Empty State
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg-app;

            if root.grid-model.length > 0: PhotoGrid {
                model: root.grid-model;
                tile-clicked(id) => { root.tile-clicked(id); }
            }

            if root.grid-model.length == 0: VerticalLayout {
                alignment: center;
                spacing: Theme.space-lg;

                Text {
                    text: "\u{1F4F7}"; // Camera emoji
                    font-size: Theme.font-display;
                    horizontal-alignment: center;
                }

                Text {
                    text: "No photos in your catalog";
                    color: Theme.text-muted;
                    font-size: Theme.font-xl;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Click Import to add photos";
                    color: Theme.text-disabled;
                    font-size: Theme.font-lg;
                    horizontal-alignment: center;
                }

                Rectangle {
                    width: 140px;
                    height: 36px;
                    background: Theme.accent-primary;
                    border-radius: Theme.radius-lg;

                    Text {
                        text: "Import Photos";
                        color: white;
                        font-size: Theme.font-lg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { root.import-clicked(); }
                    }
                }
            }
        }

        // Right Sidebar
        Rectangle {
            width: Theme.panel-width;
            background: Theme.bg-surface;

            VerticalLayout {
                padding: Theme.space-sm;
                spacing: Theme.space-xs;

                Histogram { }

                Spacer { size: Theme.space-sm; }

                QuickDevelopPanel { }

                Spacer { size: Theme.space-md; }

                MetadataPanel { }

                // Flexible space
                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    // Filmstrip at Bottom
    Filmstrip {
        model: root.grid-model;
        tile-clicked(id) => { root.tile-clicked(id); }
    }
}
